name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always

# Pin actions to full commit SHAs before deploying to production.
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Install pinned toolchain
        run: cargo --version
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --all -- --check
      - run: cargo clippy --all-targets --all-features --locked -- -D warnings

  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Install pinned toolchain
        run: cargo --version
      - uses: Swatinem/rust-cache@v2
      - run: cargo test --all-targets --locked
%%IF_DOCKER%%

  docker:
    runs-on: ubuntu-latest
    needs: [lint, test]
    steps:
      - uses: actions/checkout@v5
      - uses: docker/setup-buildx-action@v3
      - name: Build image
        uses: docker/build-push-action@v6
        with:
          context: .
          load: true
          push: false
          tags: %%APP_NAME%%:ci
          cache-from: type=gha
          cache-to: type=gha,mode=max
      - name: Smoke test the image
        run: |
          docker run -d --name app --read-only --cap-drop ALL \
            --security-opt no-new-privileges -p 3000:3000 %%APP_NAME%%:ci
          for _ in $(seq 1 30); do
            status="$(docker inspect --format '{{.State.Health.Status}}' app)"
            [ "$status" = healthy ] && break
            sleep 1
          done
          docker inspect --format '{{.State.Health.Status}}' app | grep -qx healthy
          curl --fail --silent --show-error http://127.0.0.1:3000/health/ready
          docker stop --timeout 20 app
          test "$(docker inspect --format '{{.State.ExitCode}}' app)" = 0
%%END_IF_DOCKER%%
