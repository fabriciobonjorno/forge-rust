    #[test]
    fn pre_session_login_requires_exact_origin_and_double_submit_token() {
        use forge::http::{HeaderMap, Method, Uri};
        use uuid::Uuid;

        let value = "ab".repeat(32);
        let mut headers = HeaderMap::new();
        headers.insert(
            header::ORIGIN,
            result_ok("https://app.example.test".parse(), "valid origin header"),
        );
        headers.insert(
            header::COOKIE,
            result_ok(
                format!("{PRE_SESSION_CSRF_COOKIE_NAME}={value}").parse(),
                "valid cookie header",
            ),
        );
        headers.insert(
            CSRF_HEADER_NAME,
            result_ok(value.parse(), "valid CSRF header"),
        );
        let request = Request::new_for_test(
            Method::POST,
            Uri::from_static("/auth/login"),
            headers,
            Default::default(),
            result_ok("127.0.0.1:4000".parse(), "valid remote address"),
            Uuid::now_v7(),
        );

        assert_eq!(
            verify_pre_session_login_csrf(&request, "https://app.example.test"),
            Ok(())
        );
        assert_eq!(
            verify_pre_session_login_csrf(&request, "https://attacker.example.test"),
            Err(RequestAuthError::InvalidOrigin)
        );
    }

    #[test]
    fn pre_session_login_rejects_missing_mismatched_and_ambiguous_proofs() {
        use forge::http::{HeaderMap, Method, Uri};
        use uuid::Uuid;

        let make_request = |cookie: Option<&str>, csrf: Option<&str>| {
            let mut headers = HeaderMap::new();
            headers.insert(
                header::ORIGIN,
                result_ok("https://app.example.test".parse(), "valid origin header"),
            );
            if let Some(cookie) = cookie {
                headers.insert(
                    header::COOKIE,
                    result_ok(cookie.parse(), "valid cookie header"),
                );
            }
            if let Some(csrf) = csrf {
                headers.insert(
                    CSRF_HEADER_NAME,
                    result_ok(csrf.parse(), "valid CSRF header"),
                );
            }
            Request::new_for_test(
                Method::POST,
                Uri::from_static("/auth/login"),
                headers,
                Default::default(),
                result_ok("127.0.0.1:4000".parse(), "valid remote address"),
                Uuid::now_v7(),
            )
        };
        let token = "ab".repeat(32);
        let cookie = format!("{PRE_SESSION_CSRF_COOKIE_NAME}={token}");

        assert_eq!(
            verify_pre_session_login_csrf(
                &make_request(None, Some(&token)),
                "https://app.example.test"
            ),
            Err(RequestAuthError::MissingCsrf)
        );
        assert_eq!(
            verify_pre_session_login_csrf(
                &make_request(Some(&cookie), Some(&"cd".repeat(32))),
                "https://app.example.test"
            ),
            Err(RequestAuthError::InvalidCsrf)
        );
        assert_eq!(
            verify_pre_session_login_csrf(
                &make_request(Some(&format!("{cookie}; {cookie}")), Some(&token)),
                "https://app.example.test"
            ),
            Err(RequestAuthError::InvalidCsrf)
        );
        assert_eq!(
            verify_pre_session_login_csrf(&make_request(Some(&cookie), Some(&token)), ""),
            Err(RequestAuthError::InvalidOrigin)
        );
    }

    #[test]
    fn pre_session_login_rejects_missing_or_duplicate_origin_and_duplicate_header() {
        use forge::http::{HeaderMap, HeaderValue, Method, Uri};
        use uuid::Uuid;

        let request = |include_origin: bool, duplicate_origin: bool, duplicate_csrf: bool| {
            let token = "ef".repeat(32);
            let mut headers = HeaderMap::new();
            if include_origin {
                headers.append(
                    header::ORIGIN,
                    result_ok("https://app.example.test".parse(), "valid origin header"),
                );
                if duplicate_origin {
                    headers.append(
                        header::ORIGIN,
                        result_ok("https://app.example.test".parse(), "valid origin header"),
                    );
                }
            }
            headers.insert(
                header::COOKIE,
                result_ok(
                    format!("{PRE_SESSION_CSRF_COOKIE_NAME}={token}").parse(),
                    "valid cookie header",
                ),
            );
            headers.append(
                CSRF_HEADER_NAME,
                result_ok::<HeaderValue, _>(token.parse(), "valid CSRF header"),
            );
            if duplicate_csrf {
                headers.append(
                    CSRF_HEADER_NAME,
                    result_ok(token.parse(), "valid repeated CSRF header"),
                );
            }
            Request::new_for_test(
                Method::POST,
                Uri::from_static("/auth/login"),
                headers,
                Default::default(),
                result_ok("127.0.0.1:4000".parse(), "valid remote address"),
                Uuid::now_v7(),
            )
        };

        assert_eq!(
            verify_pre_session_login_csrf(
                &request(false, false, false),
                "https://app.example.test"
            ),
            Err(RequestAuthError::InvalidOrigin)
        );
        assert_eq!(
            verify_pre_session_login_csrf(&request(true, true, false), "https://app.example.test"),
            Err(RequestAuthError::InvalidOrigin)
        );
        assert_eq!(
            verify_pre_session_login_csrf(&request(true, false, true), "https://app.example.test"),
            Err(RequestAuthError::InvalidCsrf)
        );
    }
