    #[test]
    fn logout_clears_both_host_only_auth_cookies_without_caching() {
        let response = clear_auth_cookies(Response::empty(StatusCode::NO_CONTENT));
        assert_eq!(response.status(), StatusCode::NO_CONTENT);
        assert_eq!(
            response
                .headers()
                .get(header::CACHE_CONTROL)
                .map(HeaderValue::as_bytes),
            Some(b"no-store".as_slice()),
        );
        let cookies: Vec<_> = response
            .headers()
            .get_all(header::SET_COOKIE)
            .iter()
            .filter_map(|header| header.to_str().ok())
            .collect();
        assert_eq!(cookies.len(), 2);
        assert!(cookies.iter().any(|cookie| {
            cookie.starts_with("__Host-forge_session=") && cookie.contains("Max-Age=0")
        }));
        assert!(cookies.iter().any(|cookie| {
            cookie.starts_with("__Host-forge_csrf=")
                && cookie.contains("Max-Age=0")
                && !cookie.contains("HttpOnly")
        }));
    }

