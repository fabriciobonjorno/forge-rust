//! Version-bound session issuance and mandatory audit share one transaction.

use crate::application::login::{LoginSessionError, LoginSessionStore, VerifiedPassword};
use crate::infrastructure::{audit::append_with, auth::insert_with};
use async_trait::async_trait;
use forge::audit::AuditEvent;
use forge::auth::{CsrfTokenDigest, Session, SessionCredentialDigest};
use sqlx::{PgPool, types::Uuid};

pub struct PostgresLoginSessionStore {
    pool: PgPool,
}

impl PostgresLoginSessionStore {
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl LoginSessionStore for PostgresLoginSessionStore {
    async fn issue_with_audit(
        &self,
        proof: &VerifiedPassword,
        session: &Session,
        bearer: &SessionCredentialDigest,
        csrf: &CsrfTokenDigest,
        event: &AuditEvent,
    ) -> Result<(), LoginSessionError> {
        if session.principal_id() != proof.principal_id() {
            return Err(LoginSessionError::InvalidCredentials);
        }
        let version = i64::try_from(proof.version().get())
            .map_err(|_| LoginSessionError::InvalidCredentials)?;
        let mut tx = self
            .pool
            .begin()
            .await
            .map_err(|_| LoginSessionError::Unavailable)?;
        // Equality on both hash and version also rejects an administrative hash
        // change that accidentally omitted the version increment.
        let principal = sqlx::query_scalar::<_, Uuid>(
            "SELECT id FROM forge_principals
             WHERE id = $1 AND version = $2 AND password_hash = $3
               AND disabled_at IS NULL FOR UPDATE",
        )
        .bind(proof.principal_id().into_uuid())
        .bind(version)
        .bind(proof.hash().expose())
        .fetch_optional(&mut *tx)
        .await
        .map_err(|_| LoginSessionError::Unavailable)?;
        if principal.is_none() {
            return Err(LoginSessionError::InvalidCredentials);
        }
        insert_with(&mut *tx, session, bearer, csrf)
            .await
            .map_err(|_| LoginSessionError::Unavailable)?;
        append_with(&mut *tx, event)
            .await
            .map_err(|_| LoginSessionError::Unavailable)?;
        tx.commit()
            .await
            .map_err(|_| LoginSessionError::Unavailable)
    }
}
