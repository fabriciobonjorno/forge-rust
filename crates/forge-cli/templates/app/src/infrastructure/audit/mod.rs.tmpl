//! PostgreSQL append-only audit sink.

use async_trait::async_trait;
use forge::audit::{
    AuditActor, AuditError, AuditErrorKind, AuditEvent, AuditOutcome, AuditReceipt, AuditSink,
};
use sqlx::PgPool;

/// PostgreSQL-backed append-only audit writer.
#[derive(Clone, Debug)]
pub struct PgAuditSink {
    pool: PgPool,
}

impl PgAuditSink {
    /// Creates an audit sink using the application's runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl AuditSink for PgAuditSink {
    async fn append(&self, event: &AuditEvent) -> Result<AuditReceipt, AuditError> {
        let occurred_at = i64::try_from(event.occurred_at().as_secs()).map_err(|_| {
            AuditError::new(
                AuditErrorKind::Rejected,
                "audit event timestamp is out of range",
                false,
            )
        })?;

        let (actor_kind, principal_id) = match event.actor() {
            AuditActor::Anonymous => ("anonymous", None),
            AuditActor::Principal(principal_id) => {
                ("principal", Some(principal_id.to_string()))
            }
            AuditActor::System => ("system", None),
        };
        let tenant_id = event.tenant_id().map(|tenant_id| tenant_id.to_string());
        let outcome = match event.outcome() {
            AuditOutcome::Allowed => "allowed",
            AuditOutcome::Denied => "denied",
            AuditOutcome::Succeeded => "succeeded",
            AuditOutcome::Failed => "failed",
        };
        let request_link = event.request_link().map(|link| link.as_str());

        sqlx::query(
            "INSERT INTO forge_audit_events (
                id, occurred_at_unix, actor_kind, principal_id, tenant_id,
                action, outcome, request_link
             ) VALUES (
                CAST($1 AS uuid), $2, $3, CAST($4 AS uuid), CAST($5 AS uuid),
                $6, $7, $8
             )",
        )
        .bind(event.id().to_string())
        .bind(occurred_at)
        .bind(actor_kind)
        .bind(principal_id)
        .bind(tenant_id)
        .bind(event.action().as_str())
        .bind(outcome)
        .bind(request_link)
        .execute(&self.pool)
        .await
        .map_err(classify_sqlx_error)?;

        Ok(AuditReceipt::stored(event.id()))
    }
}

fn classify_sqlx_error(error: sqlx::Error) -> AuditError {
    if matches!(error, sqlx::Error::Database(_)) {
        AuditError::new(
            AuditErrorKind::Rejected,
            "audit event rejected by storage",
            false,
        )
    } else {
        AuditError::new(
            AuditErrorKind::Unavailable,
            "audit sink unavailable",
            true,
        )
    }
}
