//! PostgreSQL server-side session persistence.
//!
//! Only credential digests are persisted. Raw bearer credentials are never
//! accepted by this adapter.

use async_trait::async_trait;
use forge::auth::{
    CsrfTokenDigest, LoginAttemptDecision, LoginAttemptKey, LoginAttemptPolicy, LoginAttemptStore,
    LoginAttemptStoreError, PasswordCredential, PasswordCredentialStore,
    PasswordCredentialStoreError, PasswordCredentialVersion, PasswordHash, Session,
    SessionCredentialDigest, SessionId, SessionStore, SessionStoreError, UnixTimestamp,
};
use forge::security::PrincipalId;
use sqlx::{Executor, PgPool, Postgres, types::Uuid};

/// SQLx-backed password credential lookup.
///
/// This adapter never returns whether a login was absent to the HTTP boundary;
/// the authentication mechanism maps absence/disabled/wrong-password to the same
/// public login failure.
#[derive(Clone)]
pub struct PostgresPasswordCredentialStore {
    pool: PgPool,
}

impl PostgresPasswordCredentialStore {
    /// Creates a credential store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl PasswordCredentialStore for PostgresPasswordCredentialStore {
    async fn find_by_login(
        &self,
        login: &str,
    ) -> Result<Option<PasswordCredential>, PasswordCredentialStoreError> {
        let row = sqlx::query_as::<_, (Uuid, String, bool, i64)>(
            "SELECT id, password_hash, disabled_at IS NOT NULL, version
             FROM forge_principals
             WHERE lower(login) = lower($1)
               AND password_hash IS NOT NULL
             LIMIT 1",
        )
        .bind(login)
        .fetch_optional(&self.pool)
        .await
        .map_err(|_| PasswordCredentialStoreError::Unavailable)?;

        row.map(|(principal_id, password_hash, disabled, version)| {
            let principal_id = PrincipalId::from_uuid(principal_id)
                .map_err(|_| PasswordCredentialStoreError::CorruptRecord)?;
            let password_hash = PasswordHash::new(password_hash)
                .map_err(|_| PasswordCredentialStoreError::CorruptRecord)?;
            let version = u64::try_from(version)
                .ok()
                .and_then(PasswordCredentialVersion::new)
                .ok_or(PasswordCredentialStoreError::CorruptRecord)?;
            Ok(PasswordCredential::new(
                principal_id,
                password_hash,
                disabled,
                version,
            ))
        })
        .transpose()
    }

    async fn replace_password_hash(
        &self,
        principal_id: PrincipalId,
        expected_version: PasswordCredentialVersion,
        password_hash: &PasswordHash,
    ) -> Result<(), PasswordCredentialStoreError> {
        let expected_version = i64::try_from(expected_version.get())
            .map_err(|_| PasswordCredentialStoreError::CorruptRecord)?;

        let result = sqlx::query(
            "UPDATE forge_principals
             SET password_hash = $3,
                 updated_at = clock_timestamp(),
                 version = version + 1
             WHERE id = $1
               AND version = $2
               AND disabled_at IS NULL",
        )
        .bind(principal_id.into_uuid())
        .bind(expected_version)
        .bind(password_hash.expose())
        .execute(&self.pool)
        .await
        .map_err(|_| PasswordCredentialStoreError::Unavailable)?;

        match result.rows_affected() {
            1 => Ok(()),
            _ => Err(PasswordCredentialStoreError::Conflict),
        }
    }
}

/// SQLx-backed server-side session store.
#[derive(Clone)]
pub struct PostgresSessionStore {
    pool: PgPool,
}

impl PostgresSessionStore {
    /// Creates a store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl SessionStore for PostgresSessionStore {
    async fn insert(
        &self,
        session: &Session,
        credential: &SessionCredentialDigest,
        csrf: &CsrfTokenDigest,
    ) -> Result<(), SessionStoreError> {
        insert_with(&self.pool, session, credential, csrf).await
    }

    async fn find_by_credential(
        &self,
        credential: &SessionCredentialDigest,
    ) -> Result<Option<Session>, SessionStoreError> {
        let row = sqlx::query_as::<_, (Uuid, Uuid, i64, i64, Option<i64>)>(
            "SELECT
                session.id,
                session.principal_id,
                EXTRACT(EPOCH FROM session.issued_at)::bigint,
                EXTRACT(EPOCH FROM session.expires_at)::bigint,
                EXTRACT(EPOCH FROM session.revoked_at)::bigint
             FROM forge_sessions AS session
             INNER JOIN forge_principals AS principal
                ON principal.id = session.principal_id
               AND principal.disabled_at IS NULL
             WHERE session.credential_digest = $1
             LIMIT 1",
        )
        .bind(credential.as_bytes().as_slice())
        .fetch_optional(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        row.map(restore_session).transpose()
    }

    async fn verify_csrf(
        &self,
        session_id: SessionId,
        csrf: &CsrfTokenDigest,
    ) -> Result<bool, SessionStoreError> {
        let matched = sqlx::query_scalar::<_, bool>(
            "SELECT EXISTS (
                SELECT 1
                FROM forge_sessions
                WHERE id = $1
                  AND csrf_digest = $2
                  AND revoked_at IS NULL
                  AND expires_at > now()
             )",
        )
        .bind(session_id.into_uuid())
        .bind(csrf.as_bytes().as_slice())
        .fetch_one(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        Ok(matched)
    }

    async fn revoke(
        &self,
        session_id: SessionId,
        revoked_at: UnixTimestamp,
    ) -> Result<(), SessionStoreError> {
        let revoked_at = timestamp_to_i64(revoked_at)?;
        let result = sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at = LEAST(
                 COALESCE(revoked_at, to_timestamp($2::double precision)),
                 to_timestamp($2::double precision)
             )
             WHERE id = $1
               AND issued_at <= to_timestamp($2::double precision)",
        )
        .bind(session_id.into_uuid())
        .bind(revoked_at)
        .execute(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        if result.rows_affected() == 1 {
            Ok(())
        } else {
            Err(SessionStoreError::Conflict)
        }
    }

    async fn rotate(
        &self,
        previous_session_id: SessionId,
        revoked_at: UnixTimestamp,
        replacement: &Session,
        replacement_credential: &SessionCredentialDigest,
        replacement_csrf: &CsrfTokenDigest,
    ) -> Result<(), SessionStoreError> {
        let revoked_at = timestamp_to_i64(revoked_at)?;
        let issued_at = timestamp_to_i64(replacement.issued_at())?;
        let expires_at = timestamp_to_i64(replacement.expires_at())?;
        let replacement_revoked_at = replacement.revoked_at().map(timestamp_to_i64).transpose()?;

        let mut transaction = self.pool.begin().await.map_err(map_sqlx_error)?;

        let updated = sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at = LEAST(
                 COALESCE(revoked_at, to_timestamp($2::double precision)),
                 to_timestamp($2::double precision)
             )
             WHERE id = $1
               AND revoked_at IS NULL
               AND expires_at > to_timestamp($2::double precision)
               AND issued_at <= to_timestamp($2::double precision)",
        )
        .bind(previous_session_id.into_uuid())
        .bind(revoked_at)
        .execute(&mut *transaction)
        .await
        .map_err(map_sqlx_error)?;

        if updated.rows_affected() != 1 {
            return Err(SessionStoreError::Conflict);
        }

        sqlx::query(
            "INSERT INTO forge_sessions (
                id, principal_id, credential_digest, csrf_digest,
                issued_at, expires_at, revoked_at
             )
             VALUES (
                $1, $2, $3, $4,
                to_timestamp($5::double precision),
                to_timestamp($6::double precision),
                CASE
                    WHEN $7::bigint IS NULL THEN NULL
                    ELSE to_timestamp($7::double precision)
                END
             )",
        )
        .bind(replacement.id().into_uuid())
        .bind(replacement.principal_id().into_uuid())
        .bind(replacement_credential.as_bytes().as_slice())
        .bind(replacement_csrf.as_bytes().as_slice())
        .bind(issued_at)
        .bind(expires_at)
        .bind(replacement_revoked_at)
        .execute(&mut *transaction)
        .await
        .map_err(map_sqlx_error)?;

        transaction.commit().await.map_err(map_sqlx_error)
    }
}

/// Inserts a session through a caller-owned executor so credential/session
/// issuance can share one transaction with its mandatory audit event.
pub(crate) async fn insert_with<'e, E>(
    executor: E,
    session: &Session,
    credential: &SessionCredentialDigest,
    csrf: &CsrfTokenDigest,
) -> Result<(), SessionStoreError>
where
    E: Executor<'e, Database = Postgres>,
{
    let issued_at = timestamp_to_i64(session.issued_at())?;
    let expires_at = timestamp_to_i64(session.expires_at())?;
    let revoked_at = session.revoked_at().map(timestamp_to_i64).transpose()?;

    sqlx::query(
        "INSERT INTO forge_sessions (
            id, principal_id, credential_digest, csrf_digest,
            issued_at, expires_at, revoked_at
         )
         VALUES (
            $1, $2, $3, $4,
            to_timestamp($5::double precision),
            to_timestamp($6::double precision),
            CASE
                WHEN $7::bigint IS NULL THEN NULL
                ELSE to_timestamp($7::double precision)
            END
         )",
    )
    .bind(session.id().into_uuid())
    .bind(session.principal_id().into_uuid())
    .bind(credential.as_bytes().as_slice())
    .bind(csrf.as_bytes().as_slice())
    .bind(issued_at)
    .bind(expires_at)
    .bind(revoked_at)
    .execute(executor)
    .await
    .map_err(map_sqlx_error)?;

    Ok(())
}

fn restore_session(
    (id, principal_id, issued_at, expires_at, revoked_at): (Uuid, Uuid, i64, i64, Option<i64>),
) -> Result<Session, SessionStoreError> {
    let id = SessionId::from_uuid(id).map_err(|_| SessionStoreError::CorruptRecord)?;
    let principal_id =
        PrincipalId::from_uuid(principal_id).map_err(|_| SessionStoreError::CorruptRecord)?;
    let issued_at = timestamp_from_i64(issued_at)?;
    let expires_at = timestamp_from_i64(expires_at)?;
    let revoked_at = revoked_at.map(timestamp_from_i64).transpose()?;

    Session::restore(id, principal_id, issued_at, expires_at, revoked_at)
        .map_err(|_| SessionStoreError::CorruptRecord)
}

fn timestamp_to_i64(timestamp: UnixTimestamp) -> Result<i64, SessionStoreError> {
    i64::try_from(timestamp.as_secs()).map_err(|_| SessionStoreError::CorruptRecord)
}

fn timestamp_from_i64(timestamp: i64) -> Result<UnixTimestamp, SessionStoreError> {
    u64::try_from(timestamp)
        .map(UnixTimestamp::from_secs)
        .map_err(|_| SessionStoreError::CorruptRecord)
}

fn map_sqlx_error(error: sqlx::Error) -> SessionStoreError {
    if error.as_database_error().is_some_and(|database| {
        database
            .code()
            .as_deref()
            .is_some_and(|code| code == "23505" || code == "23503" || code == "23514")
    }) {
        SessionStoreError::Conflict
    } else {
        SessionStoreError::Unavailable
    }
}

/// PostgreSQL-backed login throttling shared by every application replica.
#[derive(Clone)]
pub struct PostgresLoginAttemptStore {
    pool: PgPool,
}

impl PostgresLoginAttemptStore {
    /// Creates a store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl LoginAttemptStore for PostgresLoginAttemptStore {
    async fn record_and_check(
        &self,
        login: &LoginAttemptKey,
        client: &LoginAttemptKey,
        policy: LoginAttemptPolicy,
    ) -> Result<LoginAttemptDecision, LoginAttemptStoreError> {
        let mut transaction = self
            .pool
            .begin()
            .await
            .map_err(map_login_attempt_sqlx_error)?;

        // Opportunistically prune a bounded batch. The transaction-scoped
        // advisory lock allows one replica at a time to do cleanup without
        // serializing ordinary throttle updates.
        let (prune,): (bool,) =
            sqlx::query_as("SELECT pg_try_advisory_xact_lock(86432245178095521)")
                .fetch_one(&mut *transaction)
                .await
                .map_err(map_login_attempt_sqlx_error)?;
        if prune {
            sqlx::query(
                "DELETE FROM forge_login_attempt_buckets
                 WHERE ctid IN (
                     SELECT ctid FROM forge_login_attempt_buckets
                     WHERE window_started_at < statement_timestamp() - INTERVAL '7 days'
                     ORDER BY window_started_at
                     LIMIT 500
                 )",
            )
            .execute(&mut *transaction)
            .await
            .map_err(map_login_attempt_sqlx_error)?;
        }

        let login_result = record_attempt_bucket(
            &mut transaction,
            1,
            login,
            policy.max_per_login(),
            policy.window_seconds(),
        )
        .await?;
        let client_result = record_attempt_bucket(
            &mut transaction,
            2,
            client,
            policy.max_per_client(),
            policy.window_seconds(),
        )
        .await?;
        transaction
            .commit()
            .await
            .map_err(map_login_attempt_sqlx_error)?;

        let retry_after = [login_result, client_result]
            .into_iter()
            .filter(|(attempts, maximum, _)| attempts > maximum)
            .map(|(_, _, retry_after)| retry_after)
            .max();

        match retry_after {
            Some(seconds) => Ok(LoginAttemptDecision::Limited {
                retry_after_seconds: std::num::NonZeroU64::new(seconds)
                    .ok_or(LoginAttemptStoreError::CorruptRecord)?,
            }),
            None => Ok(LoginAttemptDecision::Allowed),
        }
    }

    async fn clear_login(&self, login: &LoginAttemptKey) -> Result<(), LoginAttemptStoreError> {
        sqlx::query(
            "DELETE FROM forge_login_attempt_buckets
             WHERE scope = 1 AND key_digest = $1",
        )
        .bind(login.as_bytes().as_slice())
        .execute(&self.pool)
        .await
        .map_err(map_login_attempt_sqlx_error)?;
        Ok(())
    }
}

async fn record_attempt_bucket(
    transaction: &mut sqlx::Transaction<'_, sqlx::Postgres>,
    scope: i16,
    key: &LoginAttemptKey,
    maximum: u32,
    window_seconds: u32,
) -> Result<(u32, u32, u64), LoginAttemptStoreError> {
    let row = sqlx::query_as::<_, (i64, i64)>(
        "INSERT INTO forge_login_attempt_buckets (
             scope, key_digest, window_started_at, attempt_count
         ) VALUES ($1, $2, statement_timestamp(), 1)
         ON CONFLICT (scope, key_digest) DO UPDATE SET
             window_started_at = CASE
                 WHEN forge_login_attempt_buckets.window_started_at
                      + make_interval(secs => $3::double precision) <= statement_timestamp()
                 THEN statement_timestamp()
                 ELSE forge_login_attempt_buckets.window_started_at
             END,
             attempt_count = CASE
                 WHEN forge_login_attempt_buckets.window_started_at
                      + make_interval(secs => $3::double precision) <= statement_timestamp()
                 THEN 1
                 ELSE forge_login_attempt_buckets.attempt_count + 1
             END
         RETURNING attempt_count::bigint,
             GREATEST(1, CEIL(EXTRACT(EPOCH FROM (
                 window_started_at + make_interval(secs => $3::double precision)
                 - statement_timestamp()
             )))::bigint)",
    )
    .bind(scope)
    .bind(key.as_bytes().as_slice())
    .bind(f64::from(window_seconds))
    .fetch_one(&mut **transaction)
    .await
    .map_err(map_login_attempt_sqlx_error)?;
    let attempts = u32::try_from(row.0).map_err(|_| LoginAttemptStoreError::CorruptRecord)?;
    let retry_after = u64::try_from(row.1).map_err(|_| LoginAttemptStoreError::CorruptRecord)?;
    Ok((attempts, maximum, retry_after))
}

fn map_login_attempt_sqlx_error(error: sqlx::Error) -> LoginAttemptStoreError {
    tracing::error!(error = %error, "login attempt persistence failed");
    LoginAttemptStoreError::Unavailable
}
