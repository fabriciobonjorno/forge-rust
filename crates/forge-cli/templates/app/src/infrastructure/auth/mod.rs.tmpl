//! PostgreSQL server-side session persistence.
//!
//! Only credential digests are persisted. Raw bearer credentials are never
//! accepted by this adapter.

use async_trait::async_trait;
use forge::auth::{
    Session, SessionCredentialDigest, SessionId, SessionStore, SessionStoreError, UnixTimestamp,
};
use forge::security::PrincipalId;
use sqlx::{PgPool, types::Uuid};

/// SQLx-backed server-side session store.
#[derive(Clone)]
pub struct PostgresSessionStore {
    pool: PgPool,
}

impl PostgresSessionStore {
    /// Creates a store using the least-privilege runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl SessionStore for PostgresSessionStore {
    async fn insert(
        &self,
        session: &Session,
        credential: &SessionCredentialDigest,
    ) -> Result<(), SessionStoreError> {
        let issued_at = timestamp_to_i64(session.issued_at())?;
        let expires_at = timestamp_to_i64(session.expires_at())?;
        let revoked_at = session
            .revoked_at()
            .map(timestamp_to_i64)
            .transpose()?;

        sqlx::query(
            "INSERT INTO forge_sessions (
                id, principal_id, credential_digest, issued_at, expires_at, revoked_at
             )
             VALUES (
                $1, $2, $3,
                to_timestamp($4::double precision),
                to_timestamp($5::double precision),
                CASE
                    WHEN $6::bigint IS NULL THEN NULL
                    ELSE to_timestamp($6::double precision)
                END
             )",
        )
        .bind(session.id().into_uuid())
        .bind(session.principal_id().into_uuid())
        .bind(credential.as_bytes().as_slice())
        .bind(issued_at)
        .bind(expires_at)
        .bind(revoked_at)
        .execute(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        Ok(())
    }

    async fn find_by_credential(
        &self,
        credential: &SessionCredentialDigest,
    ) -> Result<Option<Session>, SessionStoreError> {
        let row = sqlx::query_as::<_, (Uuid, Uuid, i64, i64, Option<i64>)>(
            "SELECT
                id,
                principal_id,
                EXTRACT(EPOCH FROM issued_at)::bigint,
                EXTRACT(EPOCH FROM expires_at)::bigint,
                EXTRACT(EPOCH FROM revoked_at)::bigint
             FROM forge_sessions
             WHERE credential_digest = $1
             LIMIT 1",
        )
        .bind(credential.as_bytes().as_slice())
        .fetch_optional(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        row.map(restore_session).transpose()
    }

    async fn revoke(
        &self,
        session_id: SessionId,
        revoked_at: UnixTimestamp,
    ) -> Result<(), SessionStoreError> {
        let revoked_at = timestamp_to_i64(revoked_at)?;
        let result = sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at = LEAST(
                 COALESCE(revoked_at, to_timestamp($2::double precision)),
                 to_timestamp($2::double precision)
             )
             WHERE id = $1
               AND issued_at <= to_timestamp($2::double precision)",
        )
        .bind(session_id.into_uuid())
        .bind(revoked_at)
        .execute(&self.pool)
        .await
        .map_err(map_sqlx_error)?;

        if result.rows_affected() == 1 {
            Ok(())
        } else {
            Err(SessionStoreError::Conflict)
        }
    }

    async fn rotate(
        &self,
        previous_session_id: SessionId,
        revoked_at: UnixTimestamp,
        replacement: &Session,
        replacement_credential: &SessionCredentialDigest,
    ) -> Result<(), SessionStoreError> {
        let revoked_at = timestamp_to_i64(revoked_at)?;
        let issued_at = timestamp_to_i64(replacement.issued_at())?;
        let expires_at = timestamp_to_i64(replacement.expires_at())?;
        let replacement_revoked_at = replacement
            .revoked_at()
            .map(timestamp_to_i64)
            .transpose()?;

        let mut transaction = self.pool.begin().await.map_err(map_sqlx_error)?;

        let updated = sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at = LEAST(
                 COALESCE(revoked_at, to_timestamp($2::double precision)),
                 to_timestamp($2::double precision)
             )
             WHERE id = $1
               AND revoked_at IS NULL
               AND expires_at > to_timestamp($2::double precision)
               AND issued_at <= to_timestamp($2::double precision)",
        )
        .bind(previous_session_id.into_uuid())
        .bind(revoked_at)
        .execute(&mut *transaction)
        .await
        .map_err(map_sqlx_error)?;

        if updated.rows_affected() != 1 {
            return Err(SessionStoreError::Conflict);
        }

        sqlx::query(
            "INSERT INTO forge_sessions (
                id, principal_id, credential_digest, issued_at, expires_at, revoked_at
             )
             VALUES (
                $1, $2, $3,
                to_timestamp($4::double precision),
                to_timestamp($5::double precision),
                CASE
                    WHEN $6::bigint IS NULL THEN NULL
                    ELSE to_timestamp($6::double precision)
                END
             )",
        )
        .bind(replacement.id().into_uuid())
        .bind(replacement.principal_id().into_uuid())
        .bind(replacement_credential.as_bytes().as_slice())
        .bind(issued_at)
        .bind(expires_at)
        .bind(replacement_revoked_at)
        .execute(&mut *transaction)
        .await
        .map_err(map_sqlx_error)?;

        transaction.commit().await.map_err(map_sqlx_error)
    }
}

fn restore_session(
    (id, principal_id, issued_at, expires_at, revoked_at): (
        Uuid,
        Uuid,
        i64,
        i64,
        Option<i64>,
    ),
) -> Result<Session, SessionStoreError> {
    let id = SessionId::from_uuid(id).map_err(|_| SessionStoreError::CorruptRecord)?;
    let principal_id =
        PrincipalId::from_uuid(principal_id).map_err(|_| SessionStoreError::CorruptRecord)?;
    let issued_at = timestamp_from_i64(issued_at)?;
    let expires_at = timestamp_from_i64(expires_at)?;
    let revoked_at = revoked_at.map(timestamp_from_i64).transpose()?;

    Session::restore(id, principal_id, issued_at, expires_at, revoked_at)
        .map_err(|_| SessionStoreError::CorruptRecord)
}

fn timestamp_to_i64(timestamp: UnixTimestamp) -> Result<i64, SessionStoreError> {
    i64::try_from(timestamp.as_secs()).map_err(|_| SessionStoreError::CorruptRecord)
}

fn timestamp_from_i64(timestamp: i64) -> Result<UnixTimestamp, SessionStoreError> {
    u64::try_from(timestamp)
        .map(UnixTimestamp::from_secs)
        .map_err(|_| SessionStoreError::CorruptRecord)
}

fn map_sqlx_error(error: sqlx::Error) -> SessionStoreError {
    if error.as_database_error().is_some_and(|database| {
        database
            .code()
            .as_deref()
            .is_some_and(|code| code == "23505" || code == "23503" || code == "23514")
    }) {
        SessionStoreError::Conflict
    } else {
        SessionStoreError::Unavailable
    }
}
