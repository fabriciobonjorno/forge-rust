//! PostgreSQL server-side session persistence.

use async_trait::async_trait;
use forge::auth::{
    Session, SessionId, SessionStore, SessionStoreError, SessionStoreErrorKind, UnixTimestamp,
};
use forge::security::PrincipalId;
use sqlx::{PgPool, Row, types::Uuid};

/// PostgreSQL-backed server-side session lifecycle store.
#[derive(Clone, Debug)]
pub struct PgSessionStore {
    pool: PgPool,
}

impl PgSessionStore {
    /// Creates a session store using the application runtime pool.
    #[must_use]
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl SessionStore for PgSessionStore {
    async fn insert(&self, session: &Session) -> Result<(), SessionStoreError> {
        sqlx::query(
            "INSERT INTO forge_sessions (
                id, principal_id, issued_at_unix, expires_at_unix, revoked_at_unix
             ) VALUES ($1, $2, $3, $4, $5)",
        )
        .bind(session.id().into_uuid())
        .bind(session.principal_id().into_uuid())
        .bind(to_i64(session.issued_at())?)
        .bind(to_i64(session.expires_at())?)
        .bind(session.revoked_at().map(to_i64).transpose()?)
        .execute(&self.pool)
        .await
        .map_err(classify_sqlx_error)?;

        Ok(())
    }

    async fn find(&self, id: SessionId) -> Result<Option<Session>, SessionStoreError> {
        let row = sqlx::query(
            "SELECT id, principal_id, issued_at_unix, expires_at_unix, revoked_at_unix
             FROM forge_sessions
             WHERE id = $1",
        )
        .bind(id.into_uuid())
        .fetch_optional(&self.pool)
        .await
        .map_err(classify_sqlx_error)?;

        row.map(restore_session).transpose()
    }

    async fn revoke(
        &self,
        id: SessionId,
        revoked_at: UnixTimestamp,
    ) -> Result<(), SessionStoreError> {
        sqlx::query(
            "UPDATE forge_sessions
             SET revoked_at_unix = COALESCE(revoked_at_unix, $2)
             WHERE id = $1",
        )
        .bind(id.into_uuid())
        .bind(to_i64(revoked_at)?)
        .execute(&self.pool)
        .await
        .map_err(classify_sqlx_error)?;

        Ok(())
    }

    async fn rotate(
        &self,
        current_id: SessionId,
        rotated_at: UnixTimestamp,
        replacement: &Session,
    ) -> Result<(), SessionStoreError> {
        let rotated_at_unix = to_i64(rotated_at)?;
        let mut transaction = self.pool.begin().await.map_err(classify_sqlx_error)?;

        let principal_id = sqlx::query_scalar::<_, Uuid>(
            "UPDATE forge_sessions
             SET revoked_at_unix = $2
             WHERE id = $1
               AND revoked_at_unix IS NULL
               AND issued_at_unix <= $2
               AND expires_at_unix > $2
             RETURNING principal_id",
        )
        .bind(current_id.into_uuid())
        .bind(rotated_at_unix)
        .fetch_optional(&mut *transaction)
        .await
        .map_err(classify_sqlx_error)?
        .ok_or_else(|| {
            SessionStoreError::new(
                SessionStoreErrorKind::Conflict,
                "session rotation conflict",
                false,
            )
        })?;

        if principal_id != replacement.principal_id().into_uuid()
            || replacement.issued_at() != rotated_at
            || replacement.revoked_at().is_some()
        {
            return Err(SessionStoreError::new(
                SessionStoreErrorKind::Conflict,
                "session replacement does not match rotation",
                false,
            ));
        }

        sqlx::query(
            "INSERT INTO forge_sessions (
                id, principal_id, issued_at_unix, expires_at_unix, revoked_at_unix
             ) VALUES ($1, $2, $3, $4, NULL)",
        )
        .bind(replacement.id().into_uuid())
        .bind(replacement.principal_id().into_uuid())
        .bind(to_i64(replacement.issued_at())?)
        .bind(to_i64(replacement.expires_at())?)
        .execute(&mut *transaction)
        .await
        .map_err(classify_sqlx_error)?;

        transaction.commit().await.map_err(classify_sqlx_error)?;
        Ok(())
    }
}

fn restore_session(row: sqlx::postgres::PgRow) -> Result<Session, SessionStoreError> {
    let id = SessionId::from_uuid(row.get::<Uuid, _>("id")).map_err(|_| corrupt())?;
    let principal_id =
        PrincipalId::from_uuid(row.get::<Uuid, _>("principal_id")).map_err(|_| corrupt())?;
    let issued_at = from_i64(row.get::<i64, _>("issued_at_unix"))?;
    let expires_at = from_i64(row.get::<i64, _>("expires_at_unix"))?;
    let revoked_at = row
        .get::<Option<i64>, _>("revoked_at_unix")
        .map(from_i64)
        .transpose()?;

    Session::restore(id, principal_id, issued_at, expires_at, revoked_at).map_err(|_| corrupt())
}

fn to_i64(timestamp: UnixTimestamp) -> Result<i64, SessionStoreError> {
    i64::try_from(timestamp.as_secs()).map_err(|_| corrupt())
}

fn from_i64(value: i64) -> Result<UnixTimestamp, SessionStoreError> {
    u64::try_from(value)
        .map(UnixTimestamp::from_secs)
        .map_err(|_| corrupt())
}

fn corrupt() -> SessionStoreError {
    SessionStoreError::new(
        SessionStoreErrorKind::Corrupt,
        "persisted session data is invalid",
        false,
    )
}

fn classify_sqlx_error(error: sqlx::Error) -> SessionStoreError {
    if let sqlx::Error::Database(database) = &error {
        if database.is_unique_violation() {
            return SessionStoreError::new(
                SessionStoreErrorKind::Conflict,
                "session persistence conflict",
                false,
            );
        }
    }

    SessionStoreError::new(
        SessionStoreErrorKind::Unavailable,
        "session store unavailable",
        true,
    )
}
