# Development convenience only; not a production orchestration contract.
services:
%%if database%%
  db:
    image: postgres:18.6-trixie@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
    environment:
      # Development-only credentials. Never reuse them in a deployment.
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: %%DATABASE_NAME%%
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "pg_isready", "--username=app", "--dbname=%%DATABASE_NAME%%"]
      interval: 2s
      timeout: 3s
      retries: 30

  migrate:
    build: .
    image: %%APP_NAME%%:dev
    command: ["migrate"]
    environment:
      FORGE_DATABASE_URL: %%DATABASE_URL_CONTAINER%%
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    depends_on:
      db:
        condition: service_healthy

%%end%%
  app:
    build: .
    image: %%APP_NAME%%:dev
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      FORGE_LOG: info
%%if database%%
      FORGE_DATABASE_URL: %%DATABASE_URL_CONTAINER%%
%%end%%
    init: true
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    # Must exceed FORGE_SHUTDOWN_GRACE_SECS (15s by default).
    stop_grace_period: 20s
%%if database%%
    depends_on:
      migrate:
        condition: service_completed_successfully

volumes:
  db-data:
%%end%%
