[package]
name = "%%APP_NAME%%"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "app"
path = "src/lib.rs"

[[bin]]
name = "%%APP_NAME%%"
path = "src/main.rs"

[dependencies]
forge = %%FORGE_DEPENDENCY%%
serde = { version = "1", features = ["derive"] }
%%if database%%
sqlx = { version = "0.9", default-features = false, features = ["chrono", "json", "macros", "migrate", "%%DATABASE_DRIVER%%", "runtime-tokio", "uuid"] }
%%end%%

[lints.rust]
unsafe_code = "forbid"

[lints.clippy]
expect_used = "deny"
unwrap_used = "deny"

[profile.release]
codegen-units = 1
lto = "thin"
strip = "symbols"
