-- Forge Phase 3 identity/session/tenancy/audit persistence.
-- Application-specific migrations may add domain columns and indexes, but these
-- framework tables keep the security/session lifecycle contract stable.

CREATE TABLE forge_principals (
    id uuid PRIMARY KEY,
    login text NOT NULL,
    password_hash text,
    disabled_at timestamptz,
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
    CHECK (char_length(login) BETWEEN 1 AND 320),
    CHECK (password_hash IS NULL OR char_length(password_hash) <= 1024)
);

CREATE UNIQUE INDEX forge_principals_login_unique
    ON forge_principals (lower(login));

CREATE TABLE forge_sessions (
    id uuid PRIMARY KEY,
    principal_id uuid NOT NULL REFERENCES forge_principals(id) ON DELETE CASCADE,
    credential_digest bytea NOT NULL UNIQUE,
    issued_at timestamptz NOT NULL,
    expires_at timestamptz NOT NULL,
    revoked_at timestamptz,
    created_at timestamptz NOT NULL DEFAULT now(),
    CHECK (octet_length(credential_digest) = 32),
    CHECK (expires_at > issued_at),
    CHECK (revoked_at IS NULL OR revoked_at >= issued_at)
);

CREATE INDEX forge_sessions_principal_active
    ON forge_sessions (principal_id, expires_at)
    WHERE revoked_at IS NULL;

CREATE TABLE forge_tenant_memberships (
    tenant_id uuid NOT NULL,
    principal_id uuid NOT NULL REFERENCES forge_principals(id) ON DELETE CASCADE,
    roles text[] NOT NULL DEFAULT '{}',
    state text NOT NULL DEFAULT 'active'
        CHECK (state IN ('active', 'suspended')),
    version bigint NOT NULL DEFAULT 1 CHECK (version > 0),
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now(),
    PRIMARY KEY (tenant_id, principal_id)
);

CREATE INDEX forge_tenant_memberships_principal
    ON forge_tenant_memberships (principal_id, tenant_id);

ALTER TABLE forge_tenant_memberships ENABLE ROW LEVEL SECURITY;
ALTER TABLE forge_tenant_memberships FORCE ROW LEVEL SECURITY;

CREATE POLICY forge_tenant_membership_scope
ON forge_tenant_memberships
FOR ALL
TO PUBLIC
USING (
    principal_id = NULLIF(current_setting('forge.principal_id', true), '')::uuid
    OR tenant_id = NULLIF(current_setting('forge.tenant_id', true), '')::uuid
)
WITH CHECK (
    tenant_id = NULLIF(current_setting('forge.tenant_id', true), '')::uuid
);

CREATE TABLE forge_audit_log (
    event_id uuid PRIMARY KEY,
    sequence_no bigint GENERATED ALWAYS AS IDENTITY UNIQUE,
    occurred_at timestamptz NOT NULL,
    principal_id uuid,
    tenant_id uuid,
    action text NOT NULL CHECK (char_length(action) BETWEEN 1 AND 96),
    outcome text NOT NULL CHECK (outcome IN ('denied', 'succeeded', 'failed')),
    target_kind text CHECK (
        target_kind IS NULL OR char_length(target_kind) BETWEEN 1 AND 64
    ),
    target_id text CHECK (
        target_id IS NULL OR char_length(target_id) BETWEEN 1 AND 200
    ),
    request_id text CHECK (
        request_id IS NULL OR char_length(request_id) BETWEEN 1 AND 96
    ),
    recorded_at timestamptz NOT NULL DEFAULT clock_timestamp()
);

ALTER TABLE forge_audit_log ENABLE ROW LEVEL SECURITY;
ALTER TABLE forge_audit_log FORCE ROW LEVEL SECURITY;

-- Runtime writers can append events but cannot read/update/delete audit rows
-- through ordinary RLS. Actor/tenant values must match transaction-local
-- authenticated context; anonymous pre-authentication events use both NULL.
CREATE POLICY forge_audit_append
ON forge_audit_log
FOR INSERT
TO PUBLIC
WITH CHECK (
    (principal_id IS NULL AND tenant_id IS NULL)
    OR (
        principal_id = NULLIF(current_setting('forge.principal_id', true), '')::uuid
        AND (
            tenant_id IS NULL
            OR tenant_id = NULLIF(current_setting('forge.tenant_id', true), '')::uuid
        )
    )
);

-- SQLx migration metadata is not application data. Local Compose default
-- privileges may have granted the runtime role DML while creating this table;
-- RLS/role provisioning outside Docker must keep it inaccessible to runtime.
DO $$
BEGIN
    IF to_regclass('public._sqlx_migrations') IS NOT NULL
       AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_runtime') THEN
        REVOKE ALL ON TABLE _sqlx_migrations FROM app_runtime;
    END IF;
END
$$;
