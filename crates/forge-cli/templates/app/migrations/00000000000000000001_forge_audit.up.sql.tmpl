CREATE TABLE forge_audit_events (
    id uuid PRIMARY KEY,
    occurred_at_unix bigint NOT NULL CHECK (occurred_at_unix >= 0),
    actor_kind text NOT NULL CHECK (actor_kind IN ('anonymous', 'principal', 'system')),
    principal_id uuid,
    tenant_id uuid,
    action text NOT NULL CHECK (
        octet_length(action) BETWEEN 1 AND 96
        AND action ~ '^([a-z0-9]|[a-z0-9][a-z0-9:._-]{0,94}[a-z0-9])$'
    ),
    outcome text NOT NULL CHECK (outcome IN ('allowed', 'denied', 'succeeded', 'failed')),
    request_link text CHECK (
        request_link IS NULL
        OR (
            octet_length(request_link) BETWEEN 1 AND 128
            AND request_link !~ '[[:cntrl:]]'
        )
    ),
    created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    CHECK (
        (actor_kind = 'principal' AND principal_id IS NOT NULL)
        OR (actor_kind <> 'principal' AND principal_id IS NULL)
    )
);

REVOKE ALL ON TABLE forge_audit_events FROM PUBLIC;

DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'app_runtime') THEN
        REVOKE ALL ON TABLE forge_audit_events FROM app_runtime;
        GRANT INSERT ON TABLE forge_audit_events TO app_runtime;
    END IF;
END
$$;

CREATE FUNCTION forge_reject_audit_mutation()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    RAISE EXCEPTION 'forge audit events are append-only';
END;
$$;

CREATE TRIGGER forge_audit_events_append_only
BEFORE UPDATE OR DELETE ON forge_audit_events
FOR EACH ROW
EXECUTE FUNCTION forge_reject_audit_mutation();
